{
  "name": "nexora",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:stable": "turbo test --filter='!@dongkseo/conversation' --filter='!@dongkseo/otel'",
    "test:experimental": "turbo test --filter=@dongkseo/conversation --filter=@dongkseo/otel",
    "clean": "turbo clean",
    "release": "pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.11.0"
}
