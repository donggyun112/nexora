{
  "name": "nexora",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:stable": "turbo test --filter='!@nexora/conversation' --filter='!@nexora/otel'",
